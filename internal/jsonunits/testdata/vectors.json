{
  "profile": "fga.json/groups-v1",
  "about": "Cases of the profile fga.json/groups-v1 (docs/design/mcp-data-tools.md). Split each payload, posted by principal, under its layout: produce exactly key, units and fields, or refuse where refused is true. Payloads and units are the exact bytes, held as JSON strings.",
  "cases": [
    {
      "name": "two groups",
      "layout": {
        "key": {
          "mode": "pointer",
          "pointer": "/sensor",
          "pattern": "[a-z0-9-]{1,48}",
          "prefix": "sensor/"
        },
        "groups": [
          {
            "name": "climate",
            "fields": [
              "/temperature",
              "/humidity",
              "/observed_at",
              "/sensor"
            ]
          },
          {
            "name": "location",
            "fields": [
              "/gps"
            ]
          }
        ]
      },
      "payload": "{\"sensor\": \"gh-north-1\", \"temperature\": 21.50, \"humidity\": 40,\n\t\"observed_at\": \"2026-11-03T08:00:00Z\", \"gps\": {\"lon\": 11.5, \"lat\": 48.1}}",
      "key": "sensor/gh-north-1",
      "units": [
        "{\"group\":\"climate\",\"fields\":{\"/humidity\":40,\"/observed_at\":\"2026-11-03T08:00:00Z\",\"/sensor\":\"gh-north-1\",\"/temperature\":21.50}}",
        "{\"group\":\"location\",\"fields\":{\"/gps\":{\"lat\":48.1,\"lon\":11.5}}}"
      ],
      "fields": [
        [
          "/humidity",
          "/observed_at",
          "/sensor",
          "/temperature"
        ],
        [
          "/gps"
        ]
      ]
    },
    {
      "name": "a group with no field present",
      "layout": {
        "key": {
          "mode": "pointer",
          "pointer": "/sensor",
          "pattern": "[a-z0-9-]{1,48}",
          "prefix": "sensor/"
        },
        "groups": [
          {
            "name": "climate",
            "fields": [
              "/temperature",
              "/humidity",
              "/observed_at",
              "/sensor"
            ]
          },
          {
            "name": "location",
            "fields": [
              "/gps"
            ]
          }
        ]
      },
      "payload": "{\"sensor\":\"gh-south-2\",\"temperature\":19}",
      "key": "sensor/gh-south-2",
      "units": [
        "{\"group\":\"climate\",\"fields\":{\"/sensor\":\"gh-south-2\",\"/temperature\":19}}",
        "{\"group\":\"location\",\"fields\":{}}"
      ],
      "fields": [
        [
          "/sensor",
          "/temperature"
        ],
        []
      ]
    },
    {
      "name": "string escapes",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/s"
            ]
          }
        ]
      },
      "payload": "{\"s\":\"<b>&é\\n\\u0001\\u001f\u2028\\\"\\\\\\/x\"}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/s\":\"<b>&é\\n\\u0001\\u001f\u2028\\\"\\\\/x\"}}"
      ],
      "fields": [
        [
          "/s"
        ]
      ]
    },
    {
      "name": "numbers keep their text",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/n"
            ]
          }
        ]
      },
      "payload": "{\"n\":[-0,1E+2,21.50,0.1e-3,123456789012345678901234567890]}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/n\":[-0,1E+2,21.50,0.1e-3,123456789012345678901234567890]}}"
      ],
      "fields": [
        [
          "/n"
        ]
      ]
    },
    {
      "name": "objects sorted, arrays kept",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/a",
              "/o"
            ]
          }
        ]
      },
      "payload": "{\"o\":{\"b\":true,\"a\":false,\"\":null},\"a\":[1,[2,{\"y\":1,\"x\":2}],null]}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/a\":[1,[2,{\"x\":2,\"y\":1}],null],\"/o\":{\"\":null,\"a\":false,\"b\":true}}}"
      ],
      "fields": [
        [
          "/a",
          "/o"
        ]
      ]
    },
    {
      "name": "escaped pointers",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/a~1b",
              "/m~0n",
              "/x/~01"
            ]
          }
        ]
      },
      "payload": "{\"a/b\":1,\"m~n\":2,\"x\":{\"~1\":3}}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/a~1b\":1,\"/m~0n\":2,\"/x/~01\":3}}"
      ],
      "fields": [
        [
          "/a~1b",
          "/m~0n",
          "/x/~01"
        ]
      ]
    },
    {
      "name": "a lone surrogate",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/s"
            ]
          }
        ]
      },
      "payload": "{\"s\":\"\\ud800x\"}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/s\":\"�x\"}}"
      ],
      "fields": [
        [
          "/s"
        ]
      ]
    },
    {
      "name": "a surrogate pair",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/s"
            ]
          }
        ]
      },
      "payload": "{\"s\":\"😀\"}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/s\":\"😀\"}}"
      ],
      "fields": [
        [
          "/s"
        ]
      ]
    },
    {
      "name": "principal key",
      "layout": {
        "key": {
          "mode": "principal",
          "pattern": "[a-z0-9-]{1,64}",
          "prefix": "device/"
        },
        "groups": [
          {
            "name": "climate",
            "fields": [
              "/temperature"
            ]
          }
        ]
      },
      "principal": "dev-7",
      "payload": "{\"temperature\":1}",
      "key": "device/dev-7",
      "units": [
        "{\"group\":\"climate\",\"fields\":{\"/temperature\":1}}"
      ],
      "fields": [
        [
          "/temperature"
        ]
      ]
    },
    {
      "name": "fixed key",
      "layout": {
        "key": {
          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/temperature"
            ]
          }
        ]
      },
      "payload": "{\"temperature\":1}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/temperature\":1}}"
      ],
      "fields": [
        [
          "/temperature"
        ]
      ]
    },
    {
      "name": "the key inside a field",
      "layout": {
        "key": {
          "mode": "pointer",
          "pointer": "/meta/id",
          "pattern": "[a-z]+"
        },
        "groups": [
          {
            "name": "meta",
            "fields": [
              "/meta"
            ]
          }
        ]
      },
      "payload": "{\"meta\":{\"site\":\"x\",\"id\":\"abc\"}}",
      "key": "abc",
      "units": [
        "{\"group\":\"meta\",\"fields\":{\"/meta\":{\"id\":\"abc\",\"site\":\"x\"}}}"
      ],
      "fields": [
        [
          "/meta"
        ]
      ]
    },
    {
      "name": "unlisted members dropped",
      "layout": {
        "key": {
          "mode": "pointer",
          "pointer": "/sensor",
          "pattern": "[a-z0-9-]{1,48}",
          "prefix": "sensor/"
        },
        "groups": [
          {
            "name": "climate",
            "fields": [
              "/temperature",
              "/humidity",
              "/observed_at",
              "/sensor"
            ]
          },
          {
            "name": "location",
            "fields": [
              "/gps"
            ]
          }
        ],
        "unlisted": "drop"
      },
      "payload": "{\"sensor\":\"a\",\"secret\":\"x\",\"temperature\":3}",
      "key": "sensor/a",
      "units": [
        "{\"group\":\"climate\",\"fields\":{\"/sensor\":\"a\",\"/temperature\":3}}",
        "{\"group\":\"location\",\"fields\":{}}"
      ],
      "fields": [
        [
          "/sensor",
          "/temperature"
        ],
        []
      ]
    },
    {
      "name": "depth 32",
      "layout": {
