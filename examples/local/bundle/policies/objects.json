{"format":"fga.policy/v1","set":"business","resource":"storage.object","scope":"","rules":[
  {"id":"owner-all","effect":"allow","actions":["read","stat","discover","read-history","discover-history","new-version","delete","delete-version","share","label","export"],"roles":["*"],"when":"resource.attributes.owner == principal.id"},
  {"id":"owner-lowers-with-approval","effect":"allow","actions":["relabel"],"roles":["*"],"requires":["approval"],
   "when":"resource.attributes.owner == principal.id"},
  {"id":"members-propose-labels","effect":"allow","actions":["propose-label"],"roles":["member"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"leads-approve-objects","effect":"allow","actions":["approve"],"roles":["lead"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"members-read","effect":"allow","actions":["read","stat","discover"],"roles":["member"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"auditors-history","effect":"allow","actions":["read-history","discover-history"],"roles":["auditor"]},
  {"id":"sources-post-reading-versions","effect":"allow","actions":["post-reading"],"roles":["source"],
   "when":"has(resource.attributes.source) && has(principal.attributes.sources) && resource.attributes.source in principal.attributes.sources"},
  {"id":"contractors-never-read","effect":"deny","actions":["read"],"roles":["contractor"]},
  {"id":"grantees-read","effect":"allow","actions":["read"],"roles":["*"],
   "when":"has(resource.attributes.shared_with) && principal.id in resource.attributes.shared_with.read"},
  {"id":"grantees-stat","effect":"allow","actions":["stat"],"roles":["*"],
   "when":"has(resource.attributes.shared_with) && principal.id in resource.attributes.shared_with.stat"},
  {"id":"grantees-discover","effect":"allow","actions":["discover"],"roles":["*"],
   "when":"has(resource.attributes.shared_with) && principal.id in resource.attributes.shared_with.discover"}]}
