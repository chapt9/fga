{"format":"fga.policy/v1","set":"business","resource":"storage.bucket","scope":"","rules":[
  {"id":"members-use-bucket","effect":"allow","actions":["create-object","list"],"roles":["member"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"leads-approve-buckets","effect":"allow","actions":["approve"],"roles":["lead"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"leads-manage-buckets","effect":"allow","actions":["manage","share"],"roles":["lead"],
   "when":"resource.attributes.project in principal.attributes.projects"},
  {"id":"sources-create-readings","effect":"allow","actions":["create-object"],"roles":["source"],
   "when":"has(resource.attributes.source) && has(principal.attributes.sources) && resource.attributes.source in principal.attributes.sources"}]}
