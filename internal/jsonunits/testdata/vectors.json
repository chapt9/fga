          "mode": "fixed",
          "prefix": "station"
        },
        "groups": [
          {
            "name": "all",
            "fields": [
              "/d"
            ]
          }
        ]
      },
      "payload": "{\"d\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}",
      "key": "station",
      "units": [
        "{\"group\":\"all\",\"fields\":{\"/d\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}"
      ],
      "fields": [
